f# ============================
# DATABASE CONFIGURATION
# ============================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tmdt_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password

# ============================
# JPA / HIBERNATE
# ============================
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# ============================
# SERVER
# ============================
SERVER_PORT=8080

# ============================
# OAUTH2 - GOOGLE LOGIN
# ============================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================
# OAUTH2 - FACEBOOK LOGIN
# ============================
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# ============================
# MAIL (SMTP GMAIL)
# ============================
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# ============================
# VNPAY
# ============================
VNP_TMN_CODE=your-tmn-code
VNP_HASH_SECRET=your-hash-secret
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:8080/api/payment/vnpay-return

# ============================
# FRONTEND URL
# ============================
APP_FRONTEND_URL=http://localhost:5173

# ============================
# CLOUDINARY
# ============================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret